VITE_SUPABASE_URL=your-supabase-project-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Backend API - Render deployment
VITE_BACKEND_URL=your-backend-url

# Raspberry Pi URL (Cloudflare quick tunnel or local)
# Set to your Cloudflare tunnel URL or leave empty for auto-discovery from Supabase pi_devices
VITE_RASPBERRY_PI_URL=your-raspberry-pi-url

# SMS Server URL (if used separately)
VITE_SMS_SERVER_URL=http://localhost:3001